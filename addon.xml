<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.gmatv" name="GMA.tv" version="2.1.0" provider-name="cmik">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.module.beautifulsoup4" version="4.9.3"/>
        <import addon="script.common.plugin.cache" version="2.6.1"/>
        <import addon="script.module.unidecode" version="1.1.1"/>
        <import addon="plugin.video.youtube" version="6.8.18+matrix.1" />
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.service" library="service.py"/>
    <extension point="xbmc.addon.metadata">
        <summary lang="en">GMA Pinoy TV</summary>
        <description lang="en">Enjoy full episodes of GMA Network shows for free! This is not an official GMA addon.</description>
        <disclaimer lang="en">No warranty here</disclaimer>
        <language>en</language>
        <platform>all</platform>
        <license>GPL-3.0-or-later</license>
        <forum></forum>
        <source>https://github.com/cmik/plugin.video.gmatv</source>
        <news>v2.1.0 (21/11/2026)
          [new] My List: add a show from its context menu, then My Shows and the last episode of each of them (kept when the catalog is reset)
          [change] The old Add to my watchlist entry of the episodes, which no longer worked, is removed
        </news>
        <assets>
            <icon>resources/icon.png</icon>
            <fanart>resources/fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
